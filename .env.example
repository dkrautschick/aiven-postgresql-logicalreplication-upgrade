# Copy to .env and adjust. Everything below has a sane default except AVN_PROJECT.
AVN_PROJECT=my-aiven-project

# Where and how big. startup-4 is enough for the demo.
CLOUD=google-europe-west1
PLAN=startup-4

# Service names and versions
SRC_SERVICE=pg-source-15
SRC_VERSION=15
DST_SERVICE=pg-target-18
DST_VERSION=18

# The database we replicate (created on both services by the scripts)
DBNAME=shop

# Replication object names
PUBLICATION=pub_shop_all
SUBSCRIPTION=sub_shop_from_pg15
SLOT=slot_shop_to_pg18

# Set to "false" when the SOURCE is not an Aiven service (RDS, Cloud SQL, Azure, self-managed).
# Then the scripts use plain CREATE PUBLICATION instead of aiven_extras and expect SRC_URI.
SOURCE_IS_AIVEN=true
# SRC_URI=postgres://user:password@host:5432/shop?sslmode=require
